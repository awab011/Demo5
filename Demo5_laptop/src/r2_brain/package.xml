<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_brain</name>
  <version>0.0.0</version>
  <description>R2 mission behaviour tree (py_trees) for ABU Robocon 2026 — Kung Fu Quest.</description>
  <maintainer email="awab011@hotmail.com">awabelgubshawi</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>r2_msgs</depend>
  <exec_depend>python3-py-trees</exec_depend>
  <exec_depend>python3-py-trees-ros</exec_depend>
  <exec_depend>python3-rich</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
